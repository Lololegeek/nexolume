# Netlify / Cloudflare Pages header rules (same policy as deploy/vercel.json and deploy/nginx.conf).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/_framework/*
  Cache-Control: public, max-age=31536000, immutable

/*.wasm
  Content-Type: application/wasm

/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/precache.json
  Cache-Control: no-cache
/main.js
  Cache-Control: no-cache
/interop.js
  Cache-Control: no-cache
/engine/*
  Cache-Control: no-cache

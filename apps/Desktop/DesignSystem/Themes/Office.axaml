<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Styles.Resources><ResourceDictionary><x:Double x:Key="TextControlPlaceholderOpacity">0.8</x:Double><ResourceDictionary.ThemeDictionaries>
<ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="TextControlBackground">#303D50</SolidColorBrush><SolidColorBrush x:Key="TextControlBackgroundPointerOver">#3D4E66</SolidColorBrush><SolidColorBrush x:Key="TextControlBackgroundFocused">#303D50</SolidColorBrush><SolidColorBrush x:Key="TextControlForeground">#EDF2FA</SolidColorBrush><SolidColorBrush x:Key="TextControlForegroundFocused">#EDF2FA</SolidColorBrush><SolidColorBrush x:Key="TextControlBorderBrush">#53647D</SolidColorBrush><SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#53647D</SolidColorBrush><SolidColorBrush x:Key="TextControlBorderBrushFocused">#7FA9FF</SolidColorBrush><SolidColorBrush x:Key="ComboBoxBackground">#303D50</SolidColorBrush><SolidColorBrush x:Key="ComboBoxForeground">#EDF2FA</SolidColorBrush><SolidColorBrush x:Key="ComboBoxBorderBrush">#53647D</SolidColorBrush><SolidColorBrush x:Key="OfficeBackground">#181E29</SolidColorBrush><SolidColorBrush x:Key="OfficePanel">#212938</SolidColorBrush><SolidColorBrush x:Key="OfficeLine">#334055</SolidColorBrush><SolidColorBrush x:Key="OfficeInk">#EDF2FA</SolidColorBrush><SolidColorBrush x:Key="OfficeMuted">#B0BDCF</SolidColorBrush><SolidColorBrush x:Key="OfficeCanvas">#2A3241</SolidColorBrush><SolidColorBrush x:Key="OfficeField">#303D50</SolidColorBrush><SolidColorBrush x:Key="OfficeHover">#34435B</SolidColorBrush><SolidColorBrush x:Key="OfficeAccent">#8AB3FF</SolidColorBrush><SolidColorBrush x:Key="OfficeAccentSoft">#2B4268</SolidColorBrush><SolidColorBrush x:Key="OfficePressed">#2C3950</SolidColorBrush><SolidColorBrush x:Key="OfficeShadow">#66000000</SolidColorBrush></ResourceDictionary>
<ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="TextControlBackground">#F1F4F9</SolidColorBrush><SolidColorBrush x:Key="TextControlBackgroundPointerOver">#E4ECF8</SolidColorBrush><SolidColorBrush x:Key="TextControlBackgroundFocused">#F1F4F9</SolidColorBrush><SolidColorBrush x:Key="TextControlForeground">#243249</SolidColorBrush><SolidColorBrush x:Key="TextControlForegroundFocused">#243249</SolidColorBrush><SolidColorBrush x:Key="TextControlBorderBrush">#AEBACB</SolidColorBrush><SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#AEBACB</SolidColorBrush><SolidColorBrush x:Key="TextControlBorderBrushFocused">#7FA9FF</SolidColorBrush><SolidColorBrush x:Key="ComboBoxBackground">#F1F4F9</SolidColorBrush><SolidColorBrush x:Key="ComboBoxForeground">#243249</SolidColorBrush><SolidColorBrush x:Key="ComboBoxBorderBrush">#AEBACB</SolidColorBrush><SolidColorBrush x:Key="OfficeBackground">#F3F5F9</SolidColorBrush><SolidColorBrush x:Key="OfficePanel">#FFFFFF</SolidColorBrush><SolidColorBrush x:Key="OfficeLine">#D6DDE8</SolidColorBrush><SolidColorBrush x:Key="OfficeInk">#243249</SolidColorBrush><SolidColorBrush x:Key="OfficeMuted">#61718A</SolidColorBrush><SolidColorBrush x:Key="OfficeCanvas">#E3E8F0</SolidColorBrush><SolidColorBrush x:Key="OfficeField">#EFF3FA</SolidColorBrush><SolidColorBrush x:Key="OfficeHover">#E0E9F8</SolidColorBrush><SolidColorBrush x:Key="OfficeAccent">#2C60B8</SolidColorBrush><SolidColorBrush x:Key="OfficeAccentSoft">#DCE8FB</SolidColorBrush><SolidColorBrush x:Key="OfficePressed">#CFDBEF</SolidColorBrush><SolidColorBrush x:Key="OfficeShadow">#33000000</SolidColorBrush></ResourceDictionary>
</ResourceDictionary.ThemeDictionaries></ResourceDictionary></Styles.Resources>
<Style Selector="FlyoutPresenter.writingOptions"><Setter Property="MaxWidth" Value="760"/><Setter Property="Padding" Value="18"/><Setter Property="Background" Value="{DynamicResource OfficePanel}"/><Setter Property="Foreground" Value="{DynamicResource OfficeInk}"/></Style>
<Style Selector="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="{DynamicResource OfficeBackground}"/><Setter Property="Foreground" Value="{DynamicResource OfficeInk}"/></Style>
<Style Selector="Button"><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="32"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent"/></Style>
<Style Selector="Button.selected"><Setter Property="Background" Value="{DynamicResource OfficeAccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource OfficeAccent}"/></Style>
<Style Selector="Button.layoutChoice"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12"/><Setter Property="VerticalContentAlignment" Value="Top"/></Style>
<Style Selector="Button.primary"><Setter Property="Background" Value="#366AC7"/><Setter Property="Foreground" Value="White"/></Style>
<Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource OfficeMuted}"/></Style>
<Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource OfficeMuted}"/></Style>
<Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource OfficePanel}"/><Setter Property="BorderBrush" Value="{DynamicResource OfficeLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style>
<Style Selector="TextBox"><Setter Property="CornerRadius" Value="5"/></Style>
<Style Selector="TabItem"><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="14,8"/></Style>
<Style Selector="Border.ribbon"><Setter Property="Background" Value="{DynamicResource OfficePanel}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderBrush" Value="{DynamicResource OfficeLine}"/><Setter Property="BorderThickness" Value="1"/></Style>
<Style Selector="Border.ribbon TextBlock"><Setter Property="Foreground" Value="{DynamicResource OfficeInk}"/></Style>
<Style Selector="Border.ribbon Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource OfficeInk}"/><Setter Property="MinHeight" Value="32"/></Style>
<Style Selector="Border.ribbon Button:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource OfficeHover}"/><Setter Property="Foreground" Value="{DynamicResource OfficeInk}"/></Style>
<Style Selector="Border.ribbon ComboBox"><Setter Property="Background" Value="{DynamicResource OfficeField}"/><Setter Property="BorderBrush" Value="{DynamicResource OfficeLine}"/><Setter Property="Foreground" Value="{DynamicResource OfficeInk}"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="7,3"/></Style>
<Style Selector="Border.ribbon NumericUpDown"><Setter Property="Background" Value="{DynamicResource OfficeField}"/><Setter Property="Foreground" Value="{DynamicResource OfficeInk}"/><Setter Property="MinHeight" Value="28"/></Style>
<Style Selector="Button.ribbonTab"><Setter Property="Background" Value="Transparent"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Padding" Value="14,5"/><Setter Property="Foreground" Value="{DynamicResource OfficeMuted}"/></Style>
<Style Selector="Button.ribbonTab.selected"><Setter Property="BorderBrush" Value="{DynamicResource OfficeAccent}"/><Setter Property="Foreground" Value="{DynamicResource OfficeInk}"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
<Style Selector="Button.quiet:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource OfficeHover}"/></Style>
<Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#457CD8"/><Setter Property="Foreground" Value="White"/></Style>
<Style Selector="Button.tile"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Background" Value="{DynamicResource OfficePanel}"/><Setter Property="BorderBrush" Value="{DynamicResource OfficeLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="CornerRadius" Value="8"/></Style>
<Style Selector="Button.tile:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource OfficeField}"/><Setter Property="BorderBrush" Value="{DynamicResource OfficeAccent}"/></Style>
<Style Selector="Button.recent"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="14,12"/><Setter Property="CornerRadius" Value="4"/></Style>
<Style Selector="Button.recent:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource OfficeField}"/></Style>
<Style Selector="TextBlock.section"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="15"/></Style>
<Style Selector="Border.ribbon TextBlock.groupLabel"><Setter Property="Foreground" Value="{DynamicResource OfficeMuted}"/><Setter Property="FontSize" Value="11"/></Style>
<Style Selector="ToolTip"><Setter Property="MaxWidth" Value="320"/></Style>
<Style Selector="ListBox#SlideList ListBoxItem"><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="CornerRadius" Value="6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
<Style Selector="ListBox#SlideList ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource OfficeField}"/><Setter Property="BorderBrush" Value="{DynamicResource OfficeAccent}"/><Setter Property="Foreground" Value="{DynamicResource OfficeInk}"/></Style>
<Style Selector="ListBox#SlideList ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource OfficeField}"/><Setter Property="Foreground" Value="{DynamicResource OfficeInk}"/></Style>
<Style Selector="Border.ribbonGroup"><Setter Property="BorderBrush" Value="{DynamicResource OfficeLine}"/><Setter Property="BorderThickness" Value="1,0,0,0"/><Setter Property="Padding" Value="18,0"/></Style>
<Style Selector="Button.stylePreview"><Setter Property="Background" Value="{DynamicResource OfficeField}"/><Setter Property="BorderBrush" Value="{DynamicResource OfficeLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
<Style Selector="Button.tool"><Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="34"/><Setter Property="MinHeight" Value="34"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="CornerRadius" Value="7"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style Selector="Button.toolText"><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="9,0"/><Setter Property="MinHeight" Value="34"/><Setter Property="Height" Value="34"/></Style>
<Style Selector="Button.bigTool"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinWidth" Value="64"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
<Style Selector="Border.ribbon Button:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource OfficePressed}"/><Setter Property="Foreground" Value="{DynamicResource OfficeInk}"/></Style>
<Style Selector="Border.ribbon Button.selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource OfficeAccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource OfficeAccent}"/></Style>
<Style Selector="Border.ribbon Button.ribbonTab /template/ ContentPresenter"><Setter Property="CornerRadius" Value="0"/></Style>
<Style Selector="Border.ribbon Button.ribbonTab.selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource OfficeInk}"/></Style>
<Style Selector="Button.quiet:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource OfficePressed}"/></Style>
<Style Selector="Button.quiet.selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource OfficeAccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource OfficeAccent}"/></Style>
<Style Selector="Button.primary"><Setter Property="FontWeight" Value="SemiBold"/></Style>
<Style Selector="Button.stylePreview:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource OfficeHover}"/><Setter Property="BorderBrush" Value="{DynamicResource OfficeAccent}"/></Style>
<Style Selector="Button.stylePreview"><Setter Property="CornerRadius" Value="8"/></Style>
<Style Selector="Border.ribbonGroup"><Setter Property="Padding" Value="10,0"/></Style>
<Style Selector="Border.sidePanel"><Setter Property="Background" Value="{DynamicResource OfficePanel}"/><Setter Property="BorderBrush" Value="{DynamicResource OfficeLine}"/></Style>
<Style Selector="Border.hairline"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource OfficeLine}"/></Style>
<Style Selector="Border.statusBar Button"><Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="9,0"/><Setter Property="FontSize" Value="12"/><Setter Property="CornerRadius" Value="5"/></Style>
<Style Selector="Slider#ZoomSlider"><Setter Property="MinWidth" Value="140"/></Style>
<Style Selector="TabItem"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="16,6"/><Setter Property="CornerRadius" Value="8,8,0,0"/></Style>
<Style Selector="ScrollViewer#PageScroll ScrollBar"><Setter Property="AllowAutoHide" Value="False"/></Style>
<Style Selector="Button:focus-visible /template/ ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource OfficeAccent}"/><Setter Property="BorderThickness" Value="2"/></Style>
<Style Selector="Border.ribbon Button:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
<Style Selector="Border.pageSheet"><Setter Property="CornerRadius" Value="3"/><Setter Property="BoxShadow" Value="0 1 2 0 #30000000, 0 10 28 0 #38000000"/></Style>
</Styles>
<Window xmlns="https://github.com/avaloniaui" xmlns:icons="using:Nexolume.Desktop.DesignSystem.Icons" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Nexolume.Desktop.Shell.MainWindow" Title="Nexolume" Icon="/Assets/Nexolume.ico" Width="1440" Height="950" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="PreferSystemChrome" ExtendClientAreaTitleBarHeightHint="44">
<Grid RowDefinitions="44,Auto,*,26">
<Border Background="{DynamicResource OfficeBackground}" Padding="12,3,150,3"><Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0"><Border Width="27" Height="27" Background="#366AC7" CornerRadius="6"><icons:OfficeIcon Kind="brand" Width="19" Height="19" Stroke="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Nexolume" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><Button x:Name="HomeButton" Content="Accueil" Classes="quiet"/><Button x:Name="FileMenuButton" Content="Fichier" Classes="quiet"/></StackPanel>
<Button Grid.Column="3" x:Name="SaveButton" ToolTip.Tip="Enregistrer (Ctrl+S)" Classes="quiet" FontSize="18"><icons:OfficeIcon Kind="save" Stroke="{DynamicResource OfficeInk}"/></Button>
<Button Grid.Column="4" x:Name="UndoButton" ToolTip.Tip="Annuler (Ctrl+Z)" Classes="quiet" FontSize="21"><icons:OfficeIcon Kind="undo" Stroke="{DynamicResource OfficeInk}"/></Button>
<Button Grid.Column="5" x:Name="RedoButton" ToolTip.Tip="Rétablir (Ctrl+Y)" Classes="quiet" FontSize="21"><icons:OfficeIcon Kind="redo" Stroke="{DynamicResource OfficeInk}"/></Button>
<TextBox x:Name="DocumentTitle" Grid.Column="6" ToolTip.Tip="Renommer le document : validez avec Entrée" Watermark="Titre du document" Margin="20,0" BorderThickness="0" Background="Transparent" MinHeight="28" Padding="8,4" MaxWidth="500" HorizontalAlignment="Center"/>
<StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6"><Button x:Name="OpenButton" Content="Ouvrir" Classes="quiet"/><Button x:Name="ThemeButton" Classes="quiet" ToolTip.Tip="Thème clair / sombre"><icons:OfficeIcon Kind="theme" Stroke="{DynamicResource OfficeInk}"/></Button></StackPanel>
</Grid></Border>
<Border Grid.Row="1" x:Name="ErrorBanner" IsVisible="False" Background="#532D3B" Padding="18,10"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="L’action n’a pas pu être terminée" Foreground="#FFFFFF" FontWeight="SemiBold"/><TextBlock x:Name="ErrorText" Foreground="#FFE0E8" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" x:Name="DismissErrorButton" Content="Fermer" Background="Transparent" Foreground="White" VerticalAlignment="Center"/></Grid></Border>
<TabControl x:Name="DocumentTabs" Grid.Row="2"/>
<Border Grid.Row="3" Padding="18,4" Background="{DynamicResource OfficeBackground}" BorderBrush="{DynamicResource OfficeLine}" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="StatusText" Text="Prêt à travailler" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" x:Name="SavedLabel" FontSize="11"/></Grid></Border>
</Grid></Window>
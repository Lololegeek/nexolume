<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="using:Nexolume.Desktop.DesignSystem.Icons" x:Class="Nexolume.Desktop.Shell.CloseDocumentDialog" Title="Enregistrer avant de fermer" Width="540" Height="290" CanResize="False" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
<Grid RowDefinitions="*,Auto"><Grid Margin="28" ColumnDefinitions="42,*" ColumnSpacing="16"><Border Width="42" Height="42" Background="{DynamicResource OfficeField}" CornerRadius="8" VerticalAlignment="Top"><icons:OfficeIcon Kind="save" Width="22" Height="22" Stroke="{DynamicResource OfficeAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Spacing="12"><TextBlock Text="Conserver vos modifications ?" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DocumentName" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Enregistrez ce document pour retrouver votre travail lors de la prochaine ouverture." Classes="muted" TextWrapping="Wrap"/></StackPanel></Grid>
<Border Grid.Row="1" Background="{DynamicResource OfficePanel}" BorderBrush="{DynamicResource OfficeLine}" BorderThickness="0,1,0,0" Padding="20,16"><Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8"><Button x:Name="DiscardButton" Content="Ne pas enregistrer" Classes="quiet"/><Button Grid.Column="2" x:Name="CancelButton" Content="Annuler" IsCancel="True"/><Button Grid.Column="3" x:Name="ConfirmSaveButton" Content="Enregistrer" Classes="primary" IsDefault="True"/></Grid></Border></Grid></Window>

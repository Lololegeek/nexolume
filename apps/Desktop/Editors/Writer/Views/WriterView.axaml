<UserControl xmlns="https://github.com/avaloniaui" xmlns:icons="using:Nexolume.Desktop.DesignSystem.Icons" xmlns:local="using:Nexolume.Desktop.Editors.Writer.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Nexolume.Desktop.Editors.Writer.Views.WriterView">
<Grid RowDefinitions="Auto,Auto,*,32">
<Grid x:Name="WriterTabs" MinHeight="44" ColumnDefinitions="*,Auto" Margin="16,2,16,0"><StackPanel Orientation="Horizontal" Spacing="2"><Button x:Name="HomeRibbonTab" Content="Accueil" Classes="ribbonTab selected"/><Button x:Name="InsertRibbonTab" Content="Insertion" Classes="ribbonTab"/><Button x:Name="LayoutRibbonTab" Content="Mise en page" Classes="ribbonTab"/><Button x:Name="ReviewRibbonTab" Content="Révision" Classes="ribbonTab"/><Button x:Name="ViewRibbonTab" Content="Affichage" Classes="ribbonTab"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><Button x:Name="NavigationButton" Classes="quiet" Padding="10,0" ToolTip.Tip="Naviguer entre les titres du document"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="outline" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Plan" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="FocusModeButton" Classes="quiet" Padding="10,0" ToolTip.Tip="Masquer les outils pour écrire · Échap pour revenir"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="focus" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Concentration" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="RibbonToggleButton" Content="Masquer le ruban" Classes="quiet" FontSize="12" Padding="10,0" VerticalContentAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource OfficeMuted}"/></StackPanel></Grid>
<Border x:Name="RibbonBorder" Grid.Row="1" Classes="ribbon" Margin="16,2,16,12" Padding="8,10,8,8"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False" MinHeight="104"><Grid><Grid x:Name="HomeRibbon" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"><Border Grid.Column="0" Classes="ribbonGroup" BorderThickness="0" Padding="8,0,18,0"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button x:Name="PasteButton" Classes="bigTool" ToolTip.Tip="Coller dans le paragraphe actif (Ctrl+V)"><StackPanel Spacing="6"><icons:OfficeIcon Kind="paste" Width="26" Height="26" Stroke="{DynamicResource OfficeAccent}" HorizontalAlignment="Center"/><TextBlock Text="Coller" HorizontalAlignment="Center"/></StackPanel></Button><StackPanel Spacing="4" VerticalAlignment="Center"><Button x:Name="FormatPainterButton" Classes="toolText" ToolTip.Tip="Copie la mise en forme du curseur, puis cliquez de nouveau pour l’appliquer à la sélection"><TextBlock Text="Reproduire" VerticalAlignment="Center"/></Button><Button x:Name="CutButton" Classes="toolText" HorizontalContentAlignment="Left" ToolTip.Tip="Couper (Ctrl+X)"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="cut" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Couper" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="CopyButton" Classes="toolText" HorizontalContentAlignment="Left" ToolTip.Tip="Copier (Ctrl+C)"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="copy" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Copier" VerticalAlignment="Center"/></StackPanel></Button></StackPanel></StackPanel><TextBlock Grid.Row="1" Text="Presse-papiers" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border><Border Grid.Column="1" Classes="ribbonGroup"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Spacing="8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="6"><ComboBox x:Name="FontFamilyBox" Width="168" ToolTip.Tip="Police"/><NumericUpDown x:Name="FontSizeBox" Width="70" ShowButtonSpinner="False" Minimum="4.5" Maximum="72" Increment="1" FormatString="0.#" ToolTip.Tip="Taille en points"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="4"><Button x:Name="BoldButton" Classes="tool" Content="G" FontWeight="Bold" FontSize="15" ToolTip.Tip="Gras (Ctrl+B)"/><Button x:Name="ItalicButton" Classes="tool" Content="I" FontStyle="Italic" FontSize="15" ToolTip.Tip="Italique (Ctrl+I)"/><Button x:Name="UnderlineButton" Classes="tool" ToolTip.Tip="Souligner (Ctrl+U)"><TextBlock Text="S" FontSize="15" TextDecorations="Underline"/></Button><Button x:Name="StrikeButton" Classes="tool" ToolTip.Tip="Barré"><TextBlock Text="abc" FontSize="12" TextDecorations="Strikethrough"/></Button><Button x:Name="SubscriptButton" Classes="tool" ToolTip.Tip="Indice"><TextBlock FontSize="14"><Run Text="X"/><Run Text="2" FontSize="9" BaselineAlignment="Subscript"/></TextBlock></Button><Button x:Name="SuperscriptButton" Classes="tool" ToolTip.Tip="Exposant"><TextBlock FontSize="14"><Run Text="X"/><Run Text="2" FontSize="9" BaselineAlignment="Superscript"/></TextBlock></Button><ComboBox x:Name="FontColorBox" Width="112" Margin="6,0,0,0" ToolTip.Tip="Couleur du texte"/></StackPanel></StackPanel><TextBlock Grid.Row="1" x:Name="FontScopeLabel" Text="Police · paragraphe actif" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border><Border Grid.Column="2" Classes="ribbonGroup"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Spacing="8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="4"><Button x:Name="AlignLeftButton" Classes="tool" ToolTip.Tip="Aligner à gauche"><icons:OfficeIcon Kind="left" Width="18" Height="18" Stroke="{DynamicResource OfficeInk}"/></Button><Button x:Name="AlignCenterButton" Classes="tool" ToolTip.Tip="Centrer"><icons:OfficeIcon Kind="center" Width="18" Height="18" Stroke="{DynamicResource OfficeInk}"/></Button><Button x:Name="AlignRightButton" Classes="tool" ToolTip.Tip="Aligner à droite"><icons:OfficeIcon Kind="right" Width="18" Height="18" Stroke="{DynamicResource OfficeInk}"/></Button><Button x:Name="AlignJustifyButton" Classes="tool" ToolTip.Tip="Justifier"><icons:OfficeIcon Kind="justify" Width="18" Height="18" Stroke="{DynamicResource OfficeInk}"/></Button></StackPanel><StackPanel Orientation="Horizontal" Spacing="4"><Button x:Name="BulletButton" Classes="tool" ToolTip.Tip="Liste à puces"><icons:OfficeIcon Kind="bullets" Width="18" Height="18" Stroke="{DynamicResource OfficeInk}"/></Button><Button x:Name="NumberButton" Classes="tool" ToolTip.Tip="Liste numérotée"><icons:OfficeIcon Kind="numbers" Width="18" Height="18" Stroke="{DynamicResource OfficeInk}"/></Button><Button x:Name="AddParagraphButton" Classes="toolText" Margin="6,0,0,0" ToolTip.Tip="Nouveau paragraphe"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="plus" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Paragraphe" VerticalAlignment="Center"/></StackPanel></Button></StackPanel></StackPanel><TextBlock Grid.Row="1" Text="Paragraphe" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border><Border Grid.Column="3" Classes="ribbonGroup"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel x:Name="StyleGallery" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="NormalStyleButton" Classes="stylePreview" Width="66" Height="66"><StackPanel Spacing="6"><TextBlock Text="Aa" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="Normal" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource OfficeMuted}"/></StackPanel></Button><Button x:Name="HeadingStyleButton" Classes="stylePreview" Width="66" Height="66"><StackPanel Spacing="6"><TextBlock Text="Aa" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Titre 1" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource OfficeMuted}"/></StackPanel></Button><Button x:Name="SubtitleStyleButton" Classes="stylePreview" Width="66" Height="66"><StackPanel Spacing="6"><TextBlock Text="Aa" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Titre 2" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource OfficeMuted}"/></StackPanel></Button></StackPanel><Button x:Name="MoreStylesButton" Classes="toolText" HorizontalAlignment="Left" Margin="222,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Tous les styles : titres, citation, légende, code…"><TextBlock Text="Plus ▾" VerticalAlignment="Center"/></Button><Button x:Name="StylesCompactButton" Classes="toolText" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="styles" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Styles" VerticalAlignment="Center"/></StackPanel></Button><TextBlock Grid.Row="1" Text="Styles" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border><Border Grid.Column="4" Classes="ribbonGroup"><Grid RowDefinitions="*,Auto" MinWidth="64"><UniformGrid Columns="2" VerticalAlignment="Center"><Button x:Name="SearchButton" Classes="toolText" HorizontalContentAlignment="Left" ToolTip.Tip="Rechercher et remplacer (Ctrl+F)"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="search" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Rechercher" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="ClearFormatButton" Classes="toolText" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="eraser" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Effacer le format" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="SortButton" Classes="toolText" HorizontalContentAlignment="Left" ToolTip.Tip="Trie la sélection (ou tout le document) de A à Z"><TextBlock Text="Trier A→Z" VerticalAlignment="Center"/></Button><Button x:Name="RemoveEmptyButton" Classes="toolText" HorizontalContentAlignment="Left" ToolTip.Tip="Supprime les paragraphes vides"><TextBlock Text="Retirer les vides" VerticalAlignment="Center"/></Button><Button x:Name="JoinButton" Classes="toolText" HorizontalContentAlignment="Left" ToolTip.Tip="Fusionne les paragraphes sélectionnés en un seul"><TextBlock Text="Fusionner" VerticalAlignment="Center"/></Button><Button x:Name="ReverseButton" Classes="toolText" HorizontalContentAlignment="Left" ToolTip.Tip="Inverse l'ordre des paragraphes sélectionnés"><TextBlock Text="Inverser l'ordre" VerticalAlignment="Center"/></Button></UniformGrid><TextBlock Grid.Row="1" Text="Édition" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border></Grid><Grid x:Name="InsertRibbon" IsVisible="False" ColumnDefinitions="Auto,Auto,Auto,*" MinHeight="104"><Border Grid.Column="0" Classes="ribbonGroup" BorderThickness="0" Padding="8,0,18,0"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Spacing="4" VerticalAlignment="Center"><Button x:Name="InsertParagraphButton" Classes="toolText" HorizontalContentAlignment="Left" ToolTip.Tip="Entrée"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="plus" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Nouveau paragraphe" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="DeleteParagraphButton" Classes="toolText" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="trash" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Supprimer le paragraphe actif" VerticalAlignment="Center"/></StackPanel></Button></StackPanel><TextBlock Grid.Row="1" Text="Paragraphes" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border><Border Grid.Column="1" Classes="ribbonGroup"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Spacing="4" VerticalAlignment="Center"><Button x:Name="PageBreakButton" Classes="toolText" HorizontalContentAlignment="Left" Content="Page avant le paragraphe"/><TextBlock Text="Maj+Entrée : retour à la ligne simple" Classes="caption" Margin="4,2,0,0"/></StackPanel><TextBlock Grid.Row="1" Text="Saut de page" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border><Border Grid.Column="2" Classes="ribbonGroup" HorizontalAlignment="Left"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><Button x:Name="InsertDateButton" Classes="toolText" ToolTip.Tip="Insère la date du jour au curseur"><TextBlock Text="Date" VerticalAlignment="Center"/></Button><Button x:Name="InsertTimeButton" Classes="toolText" ToolTip.Tip="Insère l’heure au curseur"><TextBlock Text="Heure" VerticalAlignment="Center"/></Button><Button x:Name="InsertSymbolButton" Classes="toolText" ToolTip.Tip="Insère un symbole au curseur"><TextBlock Text="Symbole ▾" VerticalAlignment="Center"/></Button><Button x:Name="InsertImageButton" Classes="toolText" ToolTip.Tip="Insère une image PNG, JPEG ou GIF depuis un fichier"><TextBlock Text="Image" VerticalAlignment="Center"/></Button><Button x:Name="InsertRuleButton" Classes="toolText" ToolTip.Tip="Insère une ligne de séparation dans un nouveau paragraphe"><TextBlock Text="Ligne" VerticalAlignment="Center"/></Button><Button x:Name="InsertTocButton" Classes="toolText" ToolTip.Tip="Insère un sommaire à partir des titres du document"><TextBlock Text="Sommaire" VerticalAlignment="Center"/></Button><Button x:Name="InsertLinkButton" Classes="toolText" ToolTip.Tip="Insère ou modifie un lien hypertexte (Ctrl+K)"><TextBlock Text="Lien ▾" VerticalAlignment="Center"/></Button><Button x:Name="RemoveLinkButton" Classes="toolText" ToolTip.Tip="Supprime le lien sous le curseur ou dans la sélection"><TextBlock Text="Retirer le lien" VerticalAlignment="Center"/></Button><Button x:Name="InsertFootnoteButton" Classes="toolText" ToolTip.Tip="Ajoute une note de bas de page à la fin du paragraphe actif"><TextBlock Text="Note de bas de page" VerticalAlignment="Center"/></Button><Button x:Name="InsertCommentButton" Classes="toolText" ToolTip.Tip="Ajoute un commentaire sur le paragraphe actif"><TextBlock Text="Commentaire" VerticalAlignment="Center"/></Button></StackPanel><TextBlock Grid.Row="1" Text="Texte" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border><Border Grid.Column="3" Classes="ribbonGroup" HorizontalAlignment="Left"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><Button x:Name="InsertTableButton" Classes="toolText" ToolTip.Tip="Choisissez la taille du tableau à insérer après le paragraphe courant"><TextBlock Text="Tableau ▾" VerticalAlignment="Center"/></Button><Button x:Name="TableAddRowButton" Classes="toolText" ToolTip.Tip="Ajoute une ligne sous la cellule active"><TextBlock Text="Ligne +" VerticalAlignment="Center"/></Button><Button x:Name="TableRemoveRowButton" Classes="toolText" ToolTip.Tip="Supprime la ligne de la cellule active"><TextBlock Text="Ligne −" VerticalAlignment="Center"/></Button><Button x:Name="TableAddColumnButton" Classes="toolText" ToolTip.Tip="Ajoute une colonne à droite de la cellule active"><TextBlock Text="Colonne +" VerticalAlignment="Center"/></Button><Button x:Name="TableRemoveColumnButton" Classes="toolText" ToolTip.Tip="Supprime la colonne de la cellule active"><TextBlock Text="Colonne −" VerticalAlignment="Center"/></Button><Button x:Name="TableHeaderButton" Classes="toolText" ToolTip.Tip="Affiche ou masque la ligne d’en-tête en gras"><TextBlock Text="En-tête" VerticalAlignment="Center"/></Button><Button x:Name="TableDeleteButton" Classes="toolText" ToolTip.Tip="Supprime le tableau de la cellule active"><TextBlock Text="Supprimer le tableau" VerticalAlignment="Center"/></Button></StackPanel><TextBlock Grid.Row="1" Text="Tableau" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border></Grid><Grid x:Name="LayoutRibbon" IsVisible="False" ColumnDefinitions="Auto,Auto,Auto,Auto" MinHeight="104"><Border Grid.Column="0" Classes="ribbonGroup" BorderThickness="0" Padding="8,0,18,0"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Spacing="4" VerticalAlignment="Center"><Button x:Name="PageSetupButton" Classes="toolText" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="page" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Papier et marges…" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="PagePreviewButton" Classes="toolText" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="print" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Aperçu · PDF · Imprimer" VerticalAlignment="Center"/></StackPanel></Button></StackPanel><TextBlock Grid.Row="1" Text="Page" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border><Border Grid.Column="1" Classes="ribbonGroup"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center"><StackPanel Spacing="6" VerticalAlignment="Center"><TextBlock Text="Surlignage" Classes="caption"/><ComboBox x:Name="HighlightBox" Width="160"/></StackPanel><StackPanel Spacing="6" VerticalAlignment="Center"><TextBlock Text="Interligne" Classes="caption"/><ComboBox x:Name="LineSpacingBox" Width="120"/></StackPanel><StackPanel Spacing="6" VerticalAlignment="Center"><TextBlock Text="Espacement après (pt)" Classes="caption"/><NumericUpDown x:Name="AfterSpacingBox" Minimum="0" Maximum="72" Increment="2" Width="140"/></StackPanel></StackPanel><TextBlock Grid.Row="1" Text="Mise en forme" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border><Border Grid.Column="2" Classes="ribbonGroup"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><Button x:Name="IndentLessButton" Classes="toolText" ToolTip.Tip="Diminuer le retrait"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="indentLess" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Diminuer" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="IndentMoreButton" Classes="toolText" ToolTip.Tip="Augmenter le retrait"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="indentMore" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Augmenter" VerticalAlignment="Center"/></StackPanel></Button></StackPanel><TextBlock Grid.Row="1" Text="Retrait" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border><Border Grid.Column="3" Classes="ribbonGroup"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center"><StackPanel Spacing="6" VerticalAlignment="Center"><TextBlock Text="Trame de fond" Classes="caption"/><ComboBox x:Name="ShadingBox" Width="150" ToolTip.Tip="Couleur de fond du paragraphe"/></StackPanel><StackPanel Spacing="6" VerticalAlignment="Center"><TextBlock Text="Bordure" Classes="caption"/><ComboBox x:Name="BorderBox" Width="150" ToolTip.Tip="Bordure du paragraphe"/></StackPanel></StackPanel><TextBlock Grid.Row="1" Text="Arrière-plan" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border></Grid><Grid x:Name="ReviewRibbon" IsVisible="False" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" MinHeight="104"><Border Grid.Column="0" Classes="ribbonGroup" BorderThickness="0" Padding="8,0,18,0"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Spacing="6" VerticalAlignment="Center"><Button x:Name="AutoCorrectButton" Classes="toolText" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="check" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Correction automatique" VerticalAlignment="Center"/></StackPanel></Button><TextBlock Text="Majuscules, fautes courantes et listes" Classes="caption" Margin="4,0,0,0"/></StackPanel><TextBlock Grid.Row="1" Text="Correction" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border><Border Grid.Column="1" Classes="ribbonGroup"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Spacing="6" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="4"><Button x:Name="SentenceCaseButton" Classes="toolText" Content="Phrase" ToolTip.Tip="Majuscule en début de phrase"/><Button x:Name="LowerCaseButton" Classes="toolText" Content="abc" ToolTip.Tip="Tout en minuscules"/><Button x:Name="UpperCaseButton" Classes="toolText" Content="ABC" ToolTip.Tip="Tout en majuscules"/><Button x:Name="TitleCaseButton" Classes="toolText" Content="Aa Bb" ToolTip.Tip="Une majuscule à chaque mot"/></StackPanel><TextBlock Text="Sur la sélection ou le paragraphe actif" Classes="caption" Margin="4,0,0,0"/></StackPanel><TextBlock Grid.Row="1" Text="Changer la casse" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border><Border Grid.Column="2" Classes="ribbonGroup"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Spacing="6" VerticalAlignment="Center"><Button x:Name="SpellingButton" Classes="toolText" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="spell" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Orthographe · F7" VerticalAlignment="Center"/></StackPanel></Button><ComboBox x:Name="SpellingLanguage" Width="200"/></StackPanel><TextBlock Grid.Row="1" Text="Orthographe" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border><Border Grid.Column="3" Classes="ribbonGroup"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Spacing="6" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="4"><Button x:Name="NewCommentButton" Classes="toolText" ToolTip.Tip="Ajoute un commentaire sur le paragraphe actif"><TextBlock Text="Nouveau commentaire" VerticalAlignment="Center"/></Button><Button x:Name="ReviewPaneButton" Classes="toolText" ToolTip.Tip="Affiche ou masque le volet des commentaires et des révisions"><TextBlock Text="Volet Révisions" VerticalAlignment="Center"/></Button></StackPanel><TextBlock x:Name="CommentSummary" Text="Aucun commentaire" Classes="caption" Margin="4,0,0,0"/></StackPanel><TextBlock Grid.Row="1" Text="Commentaires" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border><Border Grid.Column="4" Classes="ribbonGroup"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Spacing="6" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="4"><Button x:Name="TrackChangesButton" Classes="toolText" ToolTip.Tip="Enregistre les modifications de texte pour pouvoir les accepter ou les refuser"><TextBlock x:Name="TrackChangesLabel" Text="Suivi des modifications : désactivé" VerticalAlignment="Center"/></Button><Button x:Name="AcceptAllButton" Classes="toolText" ToolTip.Tip="Conserve toutes les modifications suivies"><TextBlock Text="Tout accepter" VerticalAlignment="Center"/></Button><Button x:Name="RejectAllButton" Classes="toolText" ToolTip.Tip="Rétablit le texte d’origine de toutes les modifications suivies"><TextBlock Text="Tout refuser" VerticalAlignment="Center"/></Button></StackPanel><TextBlock x:Name="RevisionSummary" Text="Aucune modification suivie" Classes="caption" Margin="4,0,0,0"/></StackPanel><TextBlock Grid.Row="1" Text="Suivi" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border></Grid><Grid x:Name="ViewRibbon" IsVisible="False" ColumnDefinitions="Auto,Auto,Auto" MinHeight="104"><Border Grid.Column="0" Classes="ribbonGroup" BorderThickness="0" Padding="8,0,18,0"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="ZoomOutButton" Classes="tool" ToolTip.Tip="Réduire"><icons:OfficeIcon Kind="zoomOut" Width="18" Height="18" Stroke="{DynamicResource OfficeInk}"/></Button><Slider x:Name="ZoomSlider" Minimum="50" Maximum="150" Value="100" Width="170" TickFrequency="10" VerticalAlignment="Center"/><Button x:Name="ZoomInButton" Classes="tool" ToolTip.Tip="Agrandir"><icons:OfficeIcon Kind="zoomIn" Width="18" Height="18" Stroke="{DynamicResource OfficeInk}"/></Button><TextBlock x:Name="ZoomLabel" Text="100 %" VerticalAlignment="Center" MinWidth="46"/></StackPanel><TextBlock Grid.Row="1" Text="Zoom" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border><Border Grid.Column="1" Classes="ribbonGroup"><Grid RowDefinitions="*,Auto" MinWidth="64"><StackPanel Spacing="4" VerticalAlignment="Center"><Button x:Name="FitPageButton" Classes="toolText" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><icons:OfficeIcon Kind="fit" Width="16" Height="16" Stroke="{DynamicResource OfficeInk}"/><TextBlock Text="Ajuster à la largeur" VerticalAlignment="Center"/></StackPanel></Button><CheckBox x:Name="RulerToggle" Content="Afficher la règle" IsChecked="True" Margin="4,0,0,0"/></StackPanel><TextBlock Grid.Row="1" Text="Page" Classes="groupLabel" HorizontalAlignment="Center" Margin="0,6,0,0"/></Grid></Border></Grid></Grid></ScrollViewer></Border>
<Grid x:Name="WriterWorkspace" Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto">
<Border x:Name="SearchPanel" IsVisible="False" Width="272" Classes="sidePanel" BorderThickness="0,0,1,0" Padding="18"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Rechercher" Classes="section" FontSize="16" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="CloseSearchButton" Content="×" Classes="quiet" ToolTip.Tip="Fermer la recherche"/></Grid><TextBox x:Name="FindInput" Watermark="Texte à rechercher"/><CheckBox x:Name="MatchCaseToggle" Content="Respecter la casse" IsChecked="True"/><CheckBox x:Name="WholeWordToggle" Content="Mots entiers uniquement"/><TextBlock x:Name="FindStatus" Text="Recherche sensible à la casse" Classes="caption" TextWrapping="Wrap"/><Button x:Name="FindPreviousButton" Content="Occurrence précédente"/><Button x:Name="FindNextButton" Content="Occurrence suivante"/><Border Classes="hairline" Margin="0,8"/><TextBlock Text="Remplacer par" FontWeight="SemiBold"/><TextBox x:Name="ReplaceInput" Watermark="Nouveau texte"/><Button x:Name="ReplaceOneButton" Content="Remplacer cette occurrence"/><Button x:Name="ReplaceAllButton" Content="Tout remplacer" Classes="primary"/><TextBlock Text="Tout remplacer applique les options choisies et s’annule en une seule fois." Classes="caption" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border>
<Border x:Name="NavigationPanel" Grid.Column="1" IsVisible="False" Width="244" Classes="sidePanel" BorderThickness="0,0,1,0" Padding="18,20"><Grid RowDefinitions="Auto,Auto,*" RowSpacing="16"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Plan du document" Classes="section" FontSize="16" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="CloseNavigationButton" Content="×" Classes="quiet" ToolTip.Tip="Fermer le plan"/></Grid><TextBlock Grid.Row="1" Text="Accédez à vos titres en un clic." Classes="caption" TextWrapping="Wrap"/><ScrollViewer Grid.Row="2"><StackPanel x:Name="HeadingList" Spacing="4"/></ScrollViewer></Grid></Border>
<Border x:Name="SpellingPanel" Grid.Column="3" IsVisible="False" Width="300" Padding="18" Classes="sidePanel" BorderThickness="1,0,0,0"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Orthographe" Classes="section" FontSize="16" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="CloseSpellingButton" Content="×" Classes="quiet" ToolTip.Tip="Fermer la vérification"/></Grid><TextBlock Grid.Row="1" x:Name="SpellingStatus" Text="Vérification en cours…" Classes="caption" TextWrapping="Wrap"/><CheckBox Grid.Row="2" x:Name="UnderlineSpellingToggle" Content="Souligner les mots signalés"/><ListBox Grid.Row="3" x:Name="SpellingIssues" MinHeight="70" MaxHeight="180"/><ScrollViewer Grid.Row="4" MaxHeight="180"><StackPanel x:Name="SpellingSuggestions" Spacing="6"/></ScrollViewer><StackPanel Grid.Row="5" Spacing="8"><Button x:Name="IgnoreSpellingButton" Content="Ignorer dans ce document"/><Button x:Name="AddDictionaryButton" Content="Ajouter à mon dictionnaire"/><Button x:Name="ManageDictionaryButton" Content="Mon dictionnaire…" Classes="quiet"/></StackPanel><TextBlock Grid.Row="6" Text="Vérification locale avec les dictionnaires Windows. Les mots personnels restent dans Nexolume." Classes="caption" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border>
<ScrollViewer x:Name="PageScroll" Grid.Column="2" Background="{DynamicResource OfficeCanvas}" HorizontalScrollBarVisibility="Auto"><StackPanel Margin="32,22,32,56" HorizontalAlignment="Center" Spacing="10"><Border x:Name="WordCompatibilityNote" IsVisible="False" Width="794" Padding="16,12" CornerRadius="8" Background="{DynamicResource OfficeAccentSoft}"><TextBlock Text="DOCX · Objets et mise en page conservés lors d’un enregistrement en DOCX. Leur affichage ici reste simplifié." Classes="caption" TextWrapping="Wrap"/></Border><Border x:Name="PageRuler" Height="22" Width="794" CornerRadius="4" ClipToBounds="True"><local:PageRuler/></Border><LayoutTransformControl x:Name="PageTransform"><Border x:Name="EditorPage" Classes="pageSheet" Background="White" Padding="94,94" MinHeight="1123" Width="794"><StackPanel Spacing="0"><StackPanel x:Name="ParagraphPanel" Spacing="0"/><Border x:Name="FootnotePanel" IsVisible="False" Margin="0,28,0,0" Padding="0,10,0,0" BorderBrush="#9A9A9A" BorderThickness="0,1,0,0"><StackPanel x:Name="FootnoteList" Spacing="4"/></Border></StackPanel></Border></LayoutTransformControl></StackPanel></ScrollViewer><Border x:Name="ReviewPane" Grid.Column="3" IsVisible="False" Width="330" Background="{DynamicResource OfficePanel}" BorderBrush="{DynamicResource OfficeLine}" BorderThickness="1,0,0,0"><Grid RowDefinitions="Auto,*"><StackPanel Margin="16,14,16,8" Spacing="2"><TextBlock Text="Révisions" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ReviewPaneSummary" Classes="caption"/></StackPanel><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ReviewList" Margin="12,4,12,16" Spacing="10"/></ScrollViewer></Grid></Border>
</Grid>
<Border Grid.Row="3" Classes="statusBar" Padding="12,2" Background="{DynamicResource OfficePanel}" BorderBrush="{DynamicResource OfficeLine}" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="Auto,*,Auto"><Button x:Name="WordStatsButton" Classes="quiet" ToolTip.Tip="Statistiques du document"><TextBlock x:Name="WordCount" FontSize="12"/></Button><TextBlock x:Name="WritingLanguageLabel" Grid.Column="1" Text="Français · Format du paragraphe actif" Classes="caption" VerticalAlignment="Center" Margin="16,0"/><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"><Button x:Name="FocusExitButton" IsVisible="False" Content="Quitter la concentration · Échap" Classes="quiet"/><Button x:Name="StatusFitButton" Content="Largeur de page" Classes="quiet"/><Button x:Name="ResetZoomButton" Content="100 %" MinWidth="60" Classes="quiet" ToolTip.Tip="Rétablir le zoom à 100 %"/></StackPanel></Grid></Border>
</Grid></UserControl>

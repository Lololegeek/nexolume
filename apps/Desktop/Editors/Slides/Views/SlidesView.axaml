<UserControl xmlns="https://github.com/avaloniaui" xmlns:icons="using:Nexolume.Desktop.DesignSystem.Icons" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Nexolume.Desktop.Editors.Slides.Controls" x:Class="Nexolume.Desktop.Editors.Slides.Views.SlidesView">
<Grid RowDefinitions="42,Auto,*,36"><Grid ColumnDefinitions="*,Auto" Margin="16,2"><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><icons:OfficeIcon Kind="slides" Stroke="{DynamicResource OfficeAccent}"/><TextBlock Text="Présentation" FontWeight="SemiBold"/><Button x:Name="SlideLayoutButton" Content="Nouvelle disposition ▾" Classes="quiet"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="ToggleThumbnailsButton" Content="Miniatures" Classes="quiet"/><Button x:Name="ToggleInspectorButton" Content="Propriétés" Classes="quiet"/><Button x:Name="StartSlideshowButton" Content="Présenter · F5" Classes="primary"/></StackPanel></Grid>
<Border Grid.Row="1" Classes="ribbon" Margin="16,0,16,12" Padding="12" MinHeight="126"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False"><Grid x:Name="SlideRibbonGrid" ColumnDefinitions="278,380,280,220" MinHeight="100">
<Grid RowDefinitions="*,22" Margin="6,0,16,0"><StackPanel Spacing="9" VerticalAlignment="Center"><Button x:Name="AddSlideButton" Content="+ Nouvelle diapositive" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" Spacing="9"><Button x:Name="DuplicateSlideButton" Content="Dupliquer"/><Button x:Name="DeleteSlideButton" Content="Supprimer"/></StackPanel></StackPanel><TextBlock Grid.Row="1" Text="Diapositives" Classes="groupLabel" VerticalAlignment="Bottom"/></Grid>
<Border Grid.Column="1" Classes="ribbonGroup"><Grid RowDefinitions="*,22"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Button x:Name="AddTextButton" Content="Texte"/><Button x:Name="AddRectangleButton" Content="Rectangle"/><Button x:Name="AddEllipseButton" Content="Ellipse"/><Button x:Name="AddImageButton" Content="Image" ToolTip.Tip="Insérer une image PNG, JPEG ou GIF"/><Button x:Name="ShapesButton" Content="Autres formes ▾"/></StackPanel><TextBlock Grid.Row="1" Text="Insérer un objet" Classes="groupLabel" VerticalAlignment="Bottom"/></Grid></Border>
<Border Grid.Column="2" Classes="ribbonGroup"><Grid RowDefinitions="*,22"><StackPanel Spacing="9" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="9"><Button x:Name="DuplicateObjectButton" Content="Dupliquer l’objet"/><Button x:Name="DeleteObjectButton" Content="Supprimer"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="9"><Button x:Name="SendBackButton" Content="Arrière-plan"/><Button x:Name="BringFrontButton" Content="Premier plan"/></StackPanel></StackPanel><TextBlock Grid.Row="1" Text="Organiser" Classes="groupLabel" VerticalAlignment="Bottom"/></Grid></Border>
<Border Grid.Column="3" Classes="ribbonGroup"><Grid RowDefinitions="*,22"><StackPanel Spacing="9" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="MoveSlideUpButton" Content="↑ Monter"/><Button x:Name="MoveSlideDownButton" Content="↓ Descendre"/></StackPanel><Button x:Name="CenterObjectButton" Content="Centrer sur la diapositive" FontSize="12" HorizontalAlignment="Left"/></StackPanel><TextBlock Grid.Row="1" Text="Disposition" Classes="groupLabel" VerticalAlignment="Bottom"/></Grid></Border>
</Grid></ScrollViewer></Border>
<Grid x:Name="SlidesWorkspace" Grid.Row="2" ColumnDefinitions="184,5,*,5,268">
<Border x:Name="SlideNavigator" Background="{DynamicResource OfficePanel}" Padding="8,14"><Grid RowDefinitions="36,*"><TextBlock Text="Diapositives" Classes="section" Margin="8,4"/><ListBox x:Name="SlideList" Grid.Row="1" Background="Transparent" BorderThickness="0"/></Grid></Border><GridSplitter x:Name="NavigatorSplitter" Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource OfficeLine}"/>
<Border Grid.Column="2" Background="{DynamicResource OfficeCanvas}" Padding="32"><Viewbox Stretch="Uniform"><Border BoxShadow="0 2 6 0 #45000000"><local:SlideSurface x:Name="SlideCanvas"/></Border></Viewbox></Border><GridSplitter x:Name="InspectorSplitter" Grid.Column="3" ResizeDirection="Columns" Background="{DynamicResource OfficeLine}"/>
<Border x:Name="InspectorPanel" Grid.Column="4" Background="{DynamicResource OfficePanel}" Padding="20,20,6,20"><ScrollViewer><StackPanel Spacing="22" Margin="0,0,16,0"><StackPanel Spacing="6"><TextBlock Text="Propriétés" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ObjectKindLabel" Text="Aucun objet sélectionné" Classes="caption"/></StackPanel>
<StackPanel x:Name="PropertiesPanel" Spacing="20"><StackPanel x:Name="ObjectTextSection" Spacing="10"><TextBlock Text="Texte" Classes="section"/><TextBox x:Name="ObjectText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="108" IsUndoEnabled="False" Watermark="Texte de l’objet"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Taille" Classes="caption"/><NumericUpDown x:Name="ObjectFontSize" Minimum="10" Maximum="160" Increment="2" FormatString="0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom"><Button x:Name="ObjectBoldButton" Content="G" FontWeight="Bold" Width="34" ToolTip.Tip="Gras"/><Button x:Name="ObjectItalicButton" Content="I" FontStyle="Italic" Width="34" ToolTip.Tip="Italique"/><Button x:Name="ObjectUnderlineButton" Content="S" Width="34" ToolTip.Tip="Souligné"/></StackPanel></Grid><StackPanel Orientation="Horizontal" Spacing="4"><Button x:Name="ObjectAlignLeftButton" Content="⇤" Width="34" ToolTip.Tip="Aligner à gauche"/><Button x:Name="ObjectAlignCenterButton" Content="↔" Width="34" ToolTip.Tip="Centrer"/><Button x:Name="ObjectAlignRightButton" Content="⇥" Width="34" ToolTip.Tip="Aligner à droite"/></StackPanel></StackPanel>
<StackPanel Spacing="9"><TextBlock Text="Position et dimensions" Classes="section"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
<StackPanel Spacing="4"><TextBlock Text="X" Classes="caption"/><TextBox x:Name="ObjectX" Watermark="0"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Y" Classes="caption"/><TextBox x:Name="ObjectY" Watermark="0"/></StackPanel><StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="Largeur" Classes="caption"/><TextBox x:Name="ObjectWidth" Watermark="240"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="Hauteur" Classes="caption"/><TextBox x:Name="ObjectHeight" Watermark="160"/></StackPanel></Grid></StackPanel>
<StackPanel Spacing="10"><TextBlock Text="Couleur" Classes="section"/><TextBox x:Name="ObjectFill" Watermark="#285CB3"/><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="BlueFill" Background="#285CB3" Width="34" Height="32" ToolTip.Tip="Bleu"/><Button x:Name="GreenFill" Background="#2D806C" Width="34" Height="32" ToolTip.Tip="Vert"/><Button x:Name="OrangeFill" Background="#C97F4A" Width="34" Height="32" ToolTip.Tip="Orange"/><Button x:Name="SlateFill" Background="#48556D" Width="34" Height="32" ToolTip.Tip="Ardoise"/></StackPanel></StackPanel>
<StackPanel Spacing="9"><TextBlock Text="Apparence" Classes="section"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10"><StackPanel Spacing="4"><TextBlock Text="Rotation (°)" Classes="caption"/><NumericUpDown x:Name="ObjectRotation" Minimum="-360" Maximum="360" Increment="5" FormatString="0"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Opacité (%)" Classes="caption"/><NumericUpDown x:Name="ObjectOpacity" Minimum="5" Maximum="100" Increment="5" FormatString="0"/></StackPanel><StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="Contour" Classes="caption"/><ComboBox x:Name="ObjectLineColor" HorizontalAlignment="Stretch"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="Épaisseur" Classes="caption"/><NumericUpDown x:Name="ObjectLineWidth" Minimum="0" Maximum="40" Increment="1" FormatString="0"/></StackPanel></Grid></StackPanel>
<Button x:Name="ApplyObjectButton" Content="Appliquer les modifications" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
</StackPanel>
<StackPanel x:Name="ObjectEmptyState" Spacing="12" Margin="0,24,0,0"><icons:OfficeIcon Kind="slides" Width="32" Height="32" Stroke="{DynamicResource OfficeMuted}"/><TextBlock Text="Composez votre diapositive" FontWeight="SemiBold"/><TextBlock Text="Ajoutez un texte ou une forme avec le ruban, puis sélectionnez l’objet pour le modifier." Classes="muted" TextWrapping="Wrap"/></StackPanel>
<Border BorderBrush="{DynamicResource OfficeLine}" BorderThickness="0,1,0,0" Padding="0,14,0,0"><StackPanel Spacing="10"><TextBlock Text="Diapositive" Classes="section"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel Spacing="4"><TextBlock Text="Arrière-plan" Classes="caption"/><ComboBox x:Name="SlideBackgroundBox" HorizontalAlignment="Stretch"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Transition" Classes="caption"/><ComboBox x:Name="SlideTransitionBox" HorizontalAlignment="Stretch"/></StackPanel></Grid><TextBlock Text="Notes du présentateur" Classes="caption"/><TextBox x:Name="SlideNotes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" IsUndoEnabled="False" Watermark="Ce que vous direz à voix haute…"/></StackPanel></Border>
<Border BorderBrush="{DynamicResource OfficeLine}" BorderThickness="0,1,0,0" Padding="0,14,0,0"><TextBlock Text="Glissez pour déplacer. Utilisez la poignée inférieure droite pour redimensionner." Classes="caption" TextWrapping="Wrap"/></Border>
</StackPanel></ScrollViewer></Border>
</Grid>
<Border Grid.Row="3" Padding="12,4" Background="{DynamicResource OfficeBackground}"><TextBlock x:Name="SlideStatus" FontSize="11"/></Border>
</Grid></UserControl>

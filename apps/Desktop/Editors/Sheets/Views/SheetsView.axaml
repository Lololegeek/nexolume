<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="using:Nexolume.Desktop.DesignSystem.Icons" xmlns:local="using:Nexolume.Desktop.Editors.Sheets.Controls" x:Class="Nexolume.Desktop.Editors.Sheets.Views.SheetsView">
<Grid RowDefinitions="42,Auto,Auto,*,38">
<Grid ColumnDefinitions="*,Auto" Margin="16,0"><StackPanel Orientation="Horizontal" Spacing="4"><Button x:Name="SheetHomeTab" Content="Accueil" Classes="ribbonTab selected"/><Button x:Name="SheetFormulasTab" Content="Formules" Classes="ribbonTab"/><Button x:Name="SheetLayoutTab" Content="Disposition" Classes="ribbonTab"/><Button x:Name="SheetInsertTab" Content="Insertion" Classes="ribbonTab"/><Button x:Name="SheetViewTab" Content="Affichage" Classes="ribbonTab"/></StackPanel><TextBlock Grid.Column="1" Text="Sheets" Foreground="{DynamicResource OfficeMuted}" VerticalAlignment="Center" Margin="8,0"/></Grid>
<Border Grid.Row="1" Classes="ribbon" Margin="16,0,16,12" Padding="14,12" MinHeight="130"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><Grid MinHeight="104">
<Grid x:Name="SheetHomeRibbon" ColumnDefinitions="200,470,290,*">
<Grid RowDefinitions="*,22" Margin="0,0,18,0"><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><Button x:Name="PasteCellsButton" Padding="10,7"><StackPanel Spacing="7"><icons:OfficeIcon Kind="paste" Width="25" Height="25" Stroke="{DynamicResource OfficeInk}" HorizontalAlignment="Center"/><TextBlock Text="Coller"/></StackPanel></Button><StackPanel Spacing="6"><Button x:Name="CopyCellButton" Content="Copier" ToolTip.Tip="Copier la plage sélectionnée · Ctrl+C"/><Button x:Name="ClearCellButton" Content="Effacer" ToolTip.Tip="Effacer la sélection · Suppr"/></StackPanel></StackPanel><TextBlock Grid.Row="1" Text="Presse-papiers" Classes="groupLabel"/></Grid>
<Border Grid.Column="1" Classes="ribbonGroup"><Grid RowDefinitions="*,22"><StackPanel Spacing="10" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="CellBoldButton" Content="G" FontWeight="Bold" Width="34" ToolTip.Tip="Gras pour la sélection"/><Button x:Name="CellItalicButton" Content="I" FontStyle="Italic" Width="34" ToolTip.Tip="Italique"/><Button x:Name="CellUnderlineButton" Content="S" Width="34" ToolTip.Tip="Souligné"/><ComboBox x:Name="CellFormatBox" Width="190" ToolTip.Tip="Format des nombres"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="6"><Button x:Name="CellAlignLeftButton" Content="⇤" Width="34" ToolTip.Tip="Aligner à gauche"/><Button x:Name="CellAlignCenterButton" Content="↔" Width="34" ToolTip.Tip="Centrer"/><Button x:Name="CellAlignRightButton" Content="⇥" Width="34" ToolTip.Tip="Aligner à droite"/><ComboBox x:Name="CellColorBox" Width="118" ToolTip.Tip="Couleur du texte"/><ComboBox x:Name="CellFillBox" Width="118" ToolTip.Tip="Couleur de remplissage"/></StackPanel><TextBlock Text="Format de la sélection" Classes="caption"/></StackPanel><TextBlock Grid.Row="1" Text="Nombre et mise en forme" Classes="groupLabel"/></Grid></Border>
<Border Grid.Column="2" Classes="ribbonGroup"><Grid RowDefinitions="*,22"><StackPanel Spacing="8" VerticalAlignment="Center"><Button x:Name="SumCellButton" Content="Σ  Somme automatique" HorizontalAlignment="Left" ToolTip.Tip="Additionner les cellules au-dessus de la cellule active"/><Button x:Name="MoreFunctionsButton" Content="Autres fonctions →" HorizontalAlignment="Left"/></StackPanel><TextBlock Grid.Row="1" Text="Calcul rapide" Classes="groupLabel"/></Grid></Border>
<Border Grid.Column="3" Classes="ribbonGroup"><Grid RowDefinitions="*,22"><StackPanel Spacing="8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SortAscButton" Content="Trier A → Z" ToolTip.Tip="Trier la sélection (ou toute la table) selon la colonne active, du plus petit au plus grand"/><Button x:Name="SortDescButton" Content="Trier Z → A" ToolTip.Tip="Trier du plus grand au plus petit"/></StackPanel><CheckBox x:Name="SortHeaderToggle" Content="La première ligne est un en-tête" IsChecked="True"/></StackPanel><TextBlock Grid.Row="1" Text="Trier" Classes="groupLabel"/></Grid></Border>
</Grid>
<Grid x:Name="SheetFormulasRibbon" IsVisible="False" ColumnDefinitions="330,*"><Grid RowDefinitions="*,22" Margin="0,0,20,0"><StackPanel Spacing="10" VerticalAlignment="Center"><ComboBox x:Name="AggregateBox" Width="180" HorizontalAlignment="Left"/><Button x:Name="InsertAggregateButton" Content="Insérer sur les cellules au-dessus" HorizontalAlignment="Left"/></StackPanel><TextBlock Grid.Row="1" Text="Fonctions courantes" Classes="groupLabel"/></Grid><Border Grid.Column="1" Classes="ribbonGroup"><StackPanel Spacing="8" VerticalAlignment="Center"><TextBlock Text="Écrire une formule" FontWeight="SemiBold"/><TextBlock Text="Commencez par = puis utilisez des références, comme =A1+B1." Classes="caption"/><StackPanel Orientation="Horizontal" Spacing="10"><ComboBox x:Name="FunctionCatalogBox" Width="260" ToolTip.Tip="Catalogue de fonctions"/><Button x:Name="InsertFunctionButton" Content="Insérer la fonction" ToolTip.Tip="Insère la fonction dans la cellule active"/></StackPanel><TextBlock x:Name="FunctionHint" Text="Plus de 70 fonctions : SOMME, SI, RECHERCHEV, NB.SI, CONCAT…" Classes="caption"/></StackPanel></Border></Grid>
<Grid x:Name="SheetLayoutRibbon" IsVisible="False" ColumnDefinitions="270,230,*">
<Grid RowDefinitions="*,22" Margin="0,0,18,0"><StackPanel Spacing="8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="MergeButton" Content="Fusionner" ToolTip.Tip="Fusionner les cellules sélectionnées en une seule"/><Button x:Name="UnmergeButton" Content="Annuler la fusion" ToolTip.Tip="Séparer les cellules fusionnées"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="ColumnWidthBox" Width="125" ToolTip.Tip="Largeur des colonnes sélectionnées"/><ComboBox x:Name="RowHeightBox" Width="125" ToolTip.Tip="Hauteur des lignes sélectionnées"/></StackPanel></StackPanel><TextBlock Grid.Row="1" Text="Cellules" Classes="groupLabel"/></Grid>
<Border Grid.Column="1" Classes="ribbonGroup"><Grid RowDefinitions="*,22"><StackPanel Spacing="8" VerticalAlignment="Center"><Button x:Name="FreezeButton" Content="Figer les volets" ToolTip.Tip="Garder visibles les lignes au-dessus et les colonnes à gauche de la cellule active"/><Button x:Name="UnfreezeButton" Content="Libérer les volets"/></StackPanel><TextBlock Grid.Row="1" Text="Volets" Classes="groupLabel"/></Grid></Border>
<Border Grid.Column="2" Classes="ribbonGroup"><Grid RowDefinitions="*,22"><StackPanel Spacing="8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="RuleOpBox" Width="150" ToolTip.Tip="Condition"/><TextBox x:Name="RuleValueBox" Width="80" Watermark="Valeur"/><TextBox x:Name="RuleValue2Box" Width="80" Watermark="et"/><ComboBox x:Name="RuleFillBox" Width="130" ToolTip.Tip="Couleur appliquée"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="AddRuleButton" Content="Appliquer à la sélection"/><Button x:Name="ClearRulesButton" Content="Effacer les règles"/><TextBlock x:Name="RuleSummary" Classes="caption" VerticalAlignment="Center"/></StackPanel></StackPanel><TextBlock Grid.Row="1" Text="Mise en forme conditionnelle" Classes="groupLabel"/></Grid></Border></Grid>
<Grid x:Name="SheetInsertRibbon" IsVisible="False" ColumnDefinitions="*"><Border Classes="ribbonGroup"><Grid RowDefinitions="*,22"><StackPanel Spacing="8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="ChartKindBox" Width="170" ToolTip.Tip="Type de graphique"/><TextBox x:Name="ChartTitleBox" Width="220" Watermark="Titre du graphique"/><Button x:Name="InsertChartButton" Content="Insérer le graphique" ToolTip.Tip="Crée un graphique à partir de la plage sélectionnée : première colonne = étiquettes"/><Button x:Name="DeleteChartsButton" Content="Supprimer les graphiques"/></StackPanel><TextBlock Text="Sélectionnez une plage (étiquettes dans la première colonne, valeurs dans les suivantes)." Classes="caption"/></StackPanel><TextBlock Grid.Row="1" Text="Graphiques" Classes="groupLabel"/></Grid></Border></Grid>
<Grid x:Name="SheetViewRibbon" IsVisible="False" ColumnDefinitions="240,260,*"><StackPanel VerticalAlignment="Center" Spacing="10"><CheckBox x:Name="GridLinesToggle" Content="Afficher le quadrillage" IsChecked="True"/><CheckBox x:Name="ShowFormulasToggle" Content="Afficher les formules"/></StackPanel><Border Grid.Column="1" Classes="ribbonGroup"><StackPanel Spacing="8" VerticalAlignment="Center"><TextBlock Text="Zoom de la feuille" Classes="caption"/><StackPanel Orientation="Horizontal" Spacing="10"><Slider x:Name="SheetZoomSlider" Minimum="75" Maximum="150" Value="100" Width="150"/><TextBlock x:Name="SheetZoomLabel" Text="100 %" VerticalAlignment="Center"/></StackPanel></StackPanel></Border><Border Grid.Column="2" Classes="ribbonGroup"><StackPanel Spacing="7" VerticalAlignment="Center"><TextBlock Text="Sélectionner une plage" FontWeight="SemiBold"/><TextBlock Text="Glissez sur les cellules ou utilisez Maj + flèches." Classes="caption"/></StackPanel></Border></Grid>
</Grid></ScrollViewer></Border>
<Border Grid.Row="2" Background="{DynamicResource OfficePanel}" BorderBrush="{DynamicResource OfficeLine}" BorderThickness="0,1" Padding="16,10"><Grid ColumnDefinitions="124,34,*,Auto" ColumnSpacing="12"><TextBox x:Name="CellAddress" Text="A1" FontWeight="SemiBold" HorizontalContentAlignment="Center" ToolTip.Tip="Atteindre une cellule ou une plage : B12 ou A1:C6, puis Entrée"/><TextBlock Grid.Column="1" Text="ƒx" FontSize="21" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource OfficeAccent}"/><TextBox Grid.Column="2" x:Name="CellInput" Watermark="Saisir une valeur ou une formule, par exemple =SUM(A1:A5)" IsUndoEnabled="False"/><Button Grid.Column="3" x:Name="ApplyCell" Content="Valider" Classes="primary"/></Grid></Border>
<Grid Grid.Row="3" ColumnDefinitions="*,14,Auto" RowDefinitions="*,14"><Border x:Name="ChartPane" Grid.Column="2" Grid.RowSpan="2" IsVisible="False" Width="380" Background="{DynamicResource OfficePanel}" BorderBrush="{DynamicResource OfficeLine}" BorderThickness="1,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><local:SheetChartPanel x:Name="ChartPanel"/></ScrollViewer></Border><local:SheetGrid x:Name="GridSurface"/><TextBox x:Name="CellEditor" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="6,0" VerticalContentAlignment="Center" MinHeight="0" BorderBrush="{DynamicResource OfficeAccent}" BorderThickness="2" CornerRadius="0" Background="White" Foreground="#23382F" IsUndoEnabled="False"/><ScrollBar x:Name="VerticalScroll" Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="1048550" SmallChange="1" LargeChange="20" ViewportSize="25"/><ScrollBar x:Name="HorizontalScroll" Grid.Row="1" Orientation="Horizontal" Minimum="0" Maximum="16360" SmallChange="1" LargeChange="10" ViewportSize="10"/></Grid>
<Border Grid.Row="4" Background="{DynamicResource OfficePanel}" BorderBrush="{DynamicResource OfficeLine}" BorderThickness="0,1,0,0" Padding="16,4"><Grid ColumnDefinitions="Auto,*,Auto"><Border Background="{DynamicResource OfficeField}" CornerRadius="4" Padding="16,5"><TextBlock Text="Feuille 1" Foreground="{DynamicResource OfficeAccent}" FontWeight="SemiBold"/></Border><TextBlock Grid.Column="1" x:Name="SelectionHint" Text="A1" Classes="caption" VerticalAlignment="Center" Margin="20,0"/><TextBlock Grid.Column="2" x:Name="CellSummary" Classes="caption" VerticalAlignment="Center"/></Grid></Border>
</Grid></UserControl>

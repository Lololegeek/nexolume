<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="using:Nexolume.Desktop.DesignSystem.Icons" x:Class="Nexolume.Desktop.Home.HomeView">
<ScrollViewer><StackPanel Margin="48,36" Spacing="28" MaxWidth="1180">
<Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="Créer un document" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Une page, une feuille, une idée à présenter." Classes="muted" FontSize="14"/></StackPanel><Button Grid.Column="1" x:Name="OpenDocument" Classes="primary" VerticalAlignment="Center" Padding="18,10"><StackPanel Orientation="Horizontal" Spacing="10"><icons:OfficeIcon Kind="folder" Stroke="White"/><TextBlock Text="Ouvrir un fichier"/></StackPanel></Button></Grid>
<Grid ColumnDefinitions="*,*,*" ColumnSpacing="18">
<Button x:Name="CreateWriter" Classes="tile"><StackPanel><Border Background="#253F67" Padding="24,22" CornerRadius="7,7,0,0"><Grid ColumnDefinitions="Auto,*"><Border Background="#FFFFFF" Width="48" Height="64" CornerRadius="2"><icons:OfficeIcon Kind="document" Width="28" Height="32" Stroke="#356AC4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Spacing="4"><TextBlock Text="Writer" FontSize="21" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Texte et mise en forme" Foreground="#D2E1FA" FontSize="12"/></StackPanel></Grid></Border><Grid ColumnDefinitions="*,Auto" Margin="20,16"><TextBlock Text="Document vierge" FontWeight="SemiBold"/><icons:OfficeIcon Grid.Column="1" Kind="plus" Stroke="{DynamicResource OfficeAccent}"/></Grid></StackPanel></Button>
<Button Grid.Column="1" x:Name="CreateSheets" Classes="tile"><StackPanel><Border Background="#234C45" Padding="24,22" CornerRadius="7,7,0,0"><Grid ColumnDefinitions="Auto,*"><Border Background="#FFFFFF" Width="48" Height="64" CornerRadius="2"><icons:OfficeIcon Kind="sheets" Width="29" Height="32" Stroke="#2B7865" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Spacing="4"><TextBlock Text="Sheets" FontSize="21" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Données et formules" Foreground="#D1E9E2" FontSize="12"/></StackPanel></Grid></Border><Grid ColumnDefinitions="*,Auto" Margin="20,16"><TextBlock Text="Tableur vierge" FontWeight="SemiBold"/><icons:OfficeIcon Grid.Column="1" Kind="plus" Stroke="{DynamicResource OfficeAccent}"/></Grid></StackPanel></Button>
<Button Grid.Column="2" x:Name="CreateSlides" Classes="tile"><StackPanel><Border Background="#64432D" Padding="24,22" CornerRadius="7,7,0,0"><Grid ColumnDefinitions="Auto,*"><Border Background="#FFFFFF" Width="48" Height="64" CornerRadius="2"><icons:OfficeIcon Kind="slides" Width="29" Height="32" Stroke="#A46635" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Spacing="4"><TextBlock Text="Slides" FontSize="21" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Idées et présentations" Foreground="#F3DFC8" FontSize="12"/></StackPanel></Grid></Border><Grid ColumnDefinitions="*,Auto" Margin="20,16"><TextBlock Text="Présentation vierge" FontWeight="SemiBold"/><icons:OfficeIcon Grid.Column="1" Kind="plus" Stroke="{DynamicResource OfficeAccent}"/></Grid></StackPanel></Button>
</Grid>
<Grid ColumnDefinitions="*,300" Margin="0,8,0,-10"><StackPanel Spacing="5"><TextBlock Text="Reprendre votre travail" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Vos derniers documents enregistrés sur cet ordinateur." Classes="caption"/></StackPanel><TextBox Grid.Column="1" x:Name="RecentSearch" Watermark="Rechercher un document" VerticalAlignment="Center"><TextBox.InnerLeftContent><icons:OfficeIcon Kind="search" Stroke="{DynamicResource OfficeMuted}" Margin="8,0"/></TextBox.InnerLeftContent></TextBox></Grid>
<Grid ColumnDefinitions="*,Auto" Margin="0,-4,0,-12"><StackPanel Orientation="Horizontal" Spacing="6"><Button x:Name="RecentAll" Content="Tous" Classes="quiet selected"/><Button x:Name="RecentWriter" Content="Textes" Classes="quiet"/><Button x:Name="RecentSheets" Content="Classeurs" Classes="quiet"/><Button x:Name="RecentSlides" Content="Présentations" Classes="quiet"/></StackPanel><ComboBox x:Name="RecentSort" Grid.Column="1" Width="180" SelectedIndex="0"><ComboBoxItem Content="Récemment ouverts"/><ComboBoxItem Content="Nom de A à Z"/></ComboBox></Grid>
<Border Classes="panel" Padding="12"><StackPanel><Grid ColumnDefinitions="*,130,140" Margin="14,4,14,12"><TextBlock Text="Nom du document" Classes="caption"/><TextBlock Grid.Column="1" Text="Format" Classes="caption"/><TextBlock Grid.Column="2" Text="Dernière modification" Classes="caption"/></Grid><Border Height="1" Background="{DynamicResource OfficeLine}"/><StackPanel x:Name="RecentPanel" Margin="0,6,0,0"/>
<StackPanel x:Name="EmptyRecent" Spacing="10" Margin="24,40" HorizontalAlignment="Center"><icons:OfficeIcon Kind="folder" Width="32" Height="32" Stroke="{DynamicResource OfficeMuted}" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="Votre travail trouvera sa place ici" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="Créez un document ou ouvrez un fichier pour commencer." Classes="muted" HorizontalAlignment="Center"/></StackPanel>
</StackPanel></Border>
<Grid ColumnDefinitions="*,Auto"><TextBlock Text="En local. Vos documents restent sur votre ordinateur." Classes="caption"/><TextBlock Grid.Column="1" Text="Ctrl+N  Nouveau texte     Ctrl+O  Ouvrir" Classes="caption"/></Grid>
</StackPanel></ScrollViewer></UserControl>
